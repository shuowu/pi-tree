# ---------------------------------------------------------------------------
# Pi-Books Configuration
# Copy to .env and adjust for your setup.
#
# In dev mode, load-env.ts automatically overrides PORT and DATA_PATH
# so dev (:3947) and Docker (:3847) use separate ports and databases.
# ---------------------------------------------------------------------------

# Server
PORT=3847

# Paths (use absolute paths for Docker — ~ is not expanded)
# LIBRARY_PATH — where your books live. You can also upload books via the UI.
LIBRARY_PATH=~/.local/share/pi-books/library
DATA_PATH=~/.local/share/pi-books

# Models — see your Pi SDK model registry for available IDs
PI_MODEL=glm-5-turbo
PI_LOOKUP_MODEL=glm-5-turbo

# ---------------------------------------------------------------------------
# LLM Provider Auth (BYOK — Bring Your Own Key)
# Set the API key for your chosen provider. Only one provider is needed.
# The provider name must match PI_PROVIDER below.
#
# Get your API key from your provider's dashboard:
#   anthropic  → https://console.anthropic.com/
#   openai     → https://platform.openai.com/api-keys
#   google     → https://aistudio.google.com/apikey
#   deepseek   → https://platform.deepseek.com/
#   zhipu      → https://open.bigmodel.cn/
# ---------------------------------------------------------------------------

# Provider name (must match a built-in or models.json provider)
# Built-in providers: anthropic, openai, google, zhipu, deepseek, ...
PI_PROVIDER=zhipu

# API key for the provider above
PI_API_KEY=

# Optional: custom base URL (for proxies or self-hosted endpoints)
# PI_BASE_URL=https://your-proxy.example.com/v1
