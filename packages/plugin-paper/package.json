{
  "name": "pi-tree-paper",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc"
  },
  "piTree": {
    "sourceType": {
      "key": "paper",
      "label": "Paper",
      "icon": "file-text",
      "sessionModes": [
        "reading",
        "custom"
      ],
      "defaultMode": "reading",
      "autoStartMode": "reading",
      "hasProcessing": false,
      "concepts": true,
      "searchPlaceholder": "Search papers...",
      "chatPlaceholder": "Search arXiv, paste a paper ID, or ask about research topics…",
      "mentionKeyword": "Paper",
      "addSource": {
        "subtitle": "Add a paper to discuss and analyze",
        "fields": [
          {
            "key": "title",
            "label": "Title",
            "required": true,
            "placeholder": "Paper title"
          },
          {
            "key": "author",
            "label": "Author(s)",
            "placeholder": "Author names"
          },
          {
            "key": "arxivId",
            "label": "arXiv ID / URL",
            "placeholder": "e.g. 2301.07041",
            "metadataKey": "arxivId"
          }
        ]
      },
      "cardSubtitle": "{author}"
    },
    "routes": "./routes.ts"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "@pi-tree/plugin-sdk": "*",
    "hono": "^4.7.0",
    "typebox": "^1.2.6"
  }
}
