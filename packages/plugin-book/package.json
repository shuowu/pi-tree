{
  "name": "pi-tree-book",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc"
  },
  "piTree": {
    "sourceType": {
      "key": "book",
      "label": "Book",
      "icon": "book-open",
      "sessionModes": [
        "reading",
        "qa",
        "custom"
      ],
      "defaultMode": "reading",
      "hasProcessing": true,
      "concepts": true,
      "searchPlaceholder": "Search books...",
      "chatPlaceholder": "Ask about the book, or try: deep dive, next chapter, zoom out…",
      "systemContext": [
        "[INTERNAL CONTEXT — do NOT display this to the user]",
        "You are in a book reading session. Use the information below to navigate the book efficiently.",
        "Source ID: {sourceId} | Title: {title} | Author: {author}",
        "",
        "## Navigation Data (internal — never show raw JSON to user)",
        "Use these line numbers with the `read` tool's offset parameter to jump to any section:",
        "{file:analysis/toc.json}",
        "",
        "## Resources",
        "- Outline with chapter summaries: `{sourceId}/analysis/outline.md`",
        "- Book content: `{sourceId}/markdown/`",
        "",
        "IMPORTANT: When responding to the user, present information conversationally.",
        "Never dump raw JSON, line numbers, source IDs, or internal data.",
        "Summarize the table of contents as a readable list if the user asks about book structure."
      ],
      "addSource": {
        "subtitle": "Upload an EPUB, MOBI, PDF, or Markdown file",
        "hasFileUpload": true,
        "acceptedExtensions": [
          ".epub",
          ".mobi",
          ".pdf",
          ".md"
        ],
        "fields": [
          {
            "key": "title",
            "label": "Title",
            "required": true,
            "placeholder": "Book title"
          },
          {
            "key": "author",
            "label": "Author",
            "required": true,
            "placeholder": "Author name"
          },
          {
            "key": "year",
            "label": "Year",
            "type": "number",
            "placeholder": "Publication year"
          }
        ]
      },
      "badges": [
        {
          "field": "hasMarkdown",
          "label": "Converted",
          "color": "green"
        },
        {
          "field": "hasOutline",
          "label": "Outline",
          "color": "amber"
        },
        {
          "field": "source",
          "value": "upload",
          "label": "Uploaded",
          "color": "blue"
        }
      ],
      "cardSubtitle": "{author}, {year}"
    },
    "ui": {
      "contentPanel": "./ui/ContentPanel.tsx"
    },
    "routes": "./routes.ts",
    "routePrefix": "/api/book"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "@pi-tree/plugin-sdk": "*",
    "@pi-tree/ui": "*",
    "@lingo-reader/mobi-parser": "^0.4.6",
    "epub2": "^3.0.2",
    "pdf-parse": "^2.4.5",
    "turndown": "^7.2.4",
    "typebox": "^1.2.6"
  }
}
