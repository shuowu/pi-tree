{
  "name": "pi-tree-news",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./rss-service": "./rss-service.ts",
    "./rss-client": "./rss-client.ts",
    "./db": "./db.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "db:generate": "drizzle-kit generate",
    "db:check": "bash scripts/check-migrations.sh"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.4"
  },
  "piTree": {
    "sourceType": {
      "key": "news",
      "label": "News Feed",
      "icon": "newspaper",
      "sessionModes": [
        "news"
      ],
      "defaultMode": "news",
      "autoStartMode": "news",
      "hasProcessing": false,
      "searchPlaceholder": "Search feeds...",
      "chatPlaceholder": "Ask about the news, or try: trends, deep dive, scan AI…",
      "mentionKeyword": "News",
      "fixedSourceId": "news",
      "sessionStrategy": "time-based",
      "askAfterHours": 4,
      "staleAfterHours": 12,
      "routingContextFile": "sources/news/feeds.json",
      "routingContextLabel": "Available news feeds and topic tags",
      "tagPromptTemplate": "Focus on feeds tagged '{tags}'",
      "qualifierPromptTemplate": "Focus on the {qualifier} feed",
      "addSource": {
        "subtitle": "Configure RSS feeds and news sources"
      }
    },
    "routes": "./routes.ts",
    "routePrefix": "/api/news",
    "ui": {
      "contentPanel": "./ui/NewsDashboardPanel.tsx"
    }
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@pi-tree/plugin-sdk": "*",
    "@pi-tree/ui": "*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.0",
    "js-yaml": "^4.2.0",
    "rss-parser": "^3.13.0",
    "typebox": "^1.2.6"
  }
}
