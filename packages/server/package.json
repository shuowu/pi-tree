{
  "name": "@pi-tree/server",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./db": {
      "source": "./src/db/index.ts",
      "types": "./dist/db/index.d.ts",
      "import": "./dist/db/index.js"
    },
    "./services/*": {
      "source": "./src/services/*.ts",
      "types": "./dist/services/*.d.ts",
      "import": "./dist/services/*.js"
    },
    "./config": {
      "source": "./src/config.ts",
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./bootstrap": {
      "source": "./src/bootstrap.ts",
      "types": "./dist/bootstrap.d.ts",
      "import": "./dist/bootstrap.js"
    },
    "./app": {
      "source": "./src/app.ts",
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    }
  },
  "scripts": {
    "dev": "PORT=3947 tsx watch --conditions=source --include ../core/src --include ../plugin-book --include ../plugin-news --include ../plugin-paper --include ../plugin-youtube --include ../plugin-mcp --include ../plugin-sdk/src src/index.ts",
    "build": "tsc && npm run postbuild",
    "postbuild": "node scripts/postbuild.cjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:check": "bash scripts/check-migrations.sh",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.78.0",
    "@hono/node-server": "^1.14.0",
    "@libsql/client": "^0.17.4",
    "@lingo-reader/mobi-parser": "^0.4.6",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@pi-tree/core": "*",
    "@pi-tree/plugin-sdk": "*",
    "@pi-tree/shared": "*",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "epub2": "^3.0.2",
    "hono": "^4.7.0",
    "js-yaml": "^4.2.0",
    "pdf-parse": "^2.4.5",
    "pi-tree-book": "*",
    "pi-tree-mcp": "*",
    "pi-tree-news": "*",
    "pi-tree-paper": "*",
    "pi-tree-youtube": "*",
    "rss-parser": "^3.13.0",
    "turndown": "^7.2.4",
    "typebox": "^1.2.6",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@copilotkit/aimock": "^1.31.0",
    "@types/adm-zip": "^0.5.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.6",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.19.0",
    "vitest": "^4.1.8"
  }
}
