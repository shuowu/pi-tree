{
  "name": "@pi-tree/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./db": {
      "source": "./src/db/index.ts",
      "types": "./dist/db/index.d.ts",
      "import": "./dist/db/index.js"
    },
    "./services/*": {
      "source": "./src/services/*.ts",
      "types": "./dist/services/*.d.ts",
      "import": "./dist/services/*.js"
    },
    "./config": {
      "source": "./src/config.ts",
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --conditions=source src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.78.0",
    "@hono/node-server": "^1.14.0",
    "@lingo-reader/mobi-parser": "^0.4.6",
    "@pi-tree/core": "*",
    "@pi-tree/shared": "*",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "epub2": "^3.0.2",
    "hono": "^4.7.0",
    "pdf-parse": "^2.4.5",
    "rss-parser": "^3.13.0",
    "turndown": "^7.2.4",
    "typebox": "^1.2.6",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.6",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.19.0",
    "vitest": "^4.1.8"
  }
}
