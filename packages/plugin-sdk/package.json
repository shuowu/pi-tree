{
  "name": "@pi-tree/plugin-sdk",
  "version": "0.3.2",
  "description": "SDK for building pi-tree plugins. Provides typed services, route helpers, and manifest types for self-contained Pi packages.",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "keywords": [
    "pi-tree",
    "pi-package",
    "extension"
  ]
}
