{
  "name": "pi-tree",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/shuowu/pi-tree.git"
  },
  "description": "AI-assisted book reading with tree-structured conversations",
  "keywords": [
    "pi",
    "pi-tree",
    "pi-sdk",
    "pi-extension",
    "pi-agent",
    "ai-reading",
    "book-reader",
    "tree-structure",
    "local-first"
  ],
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev -w @pi-tree/client",
    "dev:server": "npm run dev -w @pi-tree/server",
    "build": "npm run build -w @pi-tree/shared && npm run build -w @pi-tree/core && npm run build -w @pi-tree/server && npm run build -w @pi-tree/mcp && npm run build -w @pi-tree/client",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "e2e": "playwright test",
    "docs:dev": "vitepress dev website",
    "docs:build": "vitepress build website",
    "docs:preview": "vitepress preview website",
    "docs:record-demo": "BASE_URL=http://localhost:5947 npx playwright test --config=scripts/record-demo.config.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "concurrently": "^9.1.0",
    "husky": "^9.1.7",
    "mermaid": "^11.15.0",
    "typescript": "^5.7.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  }
}
