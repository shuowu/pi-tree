{
  "name": "pi-books",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/shuowu/pi-books.git"
  },
  "description": "AI-assisted book reading with tree-structured conversations",
  "keywords": [
    "pi",
    "pi-books",
    "pi-sdk",
    "pi-extension",
    "pi-agent",
    "ai-reading",
    "book-reader",
    "tree-structure",
    "local-first"
  ],
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev -w @pi-books/client",
    "dev:server": "npm run dev -w @pi-books/server",
    "build": "npm run build -w @pi-books/shared && npm run build -w @pi-books/extension && npm run build -w @pi-books/server && npm run build -w @pi-books/mcp && npm run build -w @pi-books/client",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "e2e": "playwright test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "concurrently": "^9.1.0",
    "husky": "^9.1.7",
    "typescript": "^5.7.0"
  }
}
