{
  "name": "pi-books",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "description": "AI-assisted book reading with tree-structured conversations",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev -w @pi-books/client",
    "dev:server": "npm run dev -w @pi-books/server",
    "build": "npm run build -w @pi-books/shared && npm run build -w @pi-books/extension && npm run build -w @pi-books/server && npm run build -w @pi-books/mcp && npm run build -w @pi-books/client",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0"
  }
}
